#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
host_root="${OCP_HOST_CHECKOUT:-$repo_root/.host-contract}"
manifest_version="$(cd "$repo_root/backend" && uv run python -c 'import yaml; print(yaml.safe_load(open("../module.yaml"))["version"])')"
version="${VERSION:-$manifest_version}"

if [[ "$version" != "$manifest_version" ]]; then
  echo "Requested version $version does not match module.yaml version $manifest_version" >&2
  exit 1
fi

VERSION="$version" exec "$host_root/backend/.venv/bin/python" "$repo_root/scripts/host_contract_test.py" \
  "$host_root" "$repo_root/dist/statistics-${version}.ocp"
